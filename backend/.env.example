# ==============================================================================
# PatchPilot Backend Environment Configuration
# ==============================================================================

# Project Information
PROJECT_NAME="PatchPilot — Intelligent Security Remediation Assistant"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# Database Configuration
# Defaults to local SQLite if left empty or unconfigured.
# For PostgreSQL (Docker or local): postgresql+psycopg2://user:password@localhost:5432/patchpilot_db
DATABASE_URL="sqlite:///./patchpilot.db"

# CORS Configuration (comma-separated origins or JSON array)
# Allowed origins for frontend local dev (Vite default is 5173, CRA is 3000)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# AI Remediation Service Configuration (Optional)
# If AI_API_KEY is omitted or blank, PatchPilot automatically uses the deterministic
# rule-based fallback engine (no API key or subscription required).
AI_PROVIDER="openai"                     # e.g., 'openai', 'gemini', or leave empty for rule-based fallback
AI_API_KEY=""                            # NEVER commit real keys to version control
AI_MODEL="gpt-4o-mini"                   # e.g., 'gpt-4o-mini', 'gemini-1.5-flash'
AI_API_URL="https://api.openai.com/v1/chat/completions"

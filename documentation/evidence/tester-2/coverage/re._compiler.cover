   16:     comps = {}
   16:     mapping = bytearray(256)
   16:     block = 0
   16:     data = bytearray()
 4112:     for i in range(0, 65536, 256):
 4096:         chunk = charmap[i: i + 256]
 4096:         if chunk in comps:
 4046:             mapping[i // 256] = comps[chunk]
               else:
   50:             mapping[i // 256] = comps[chunk] = block
   50:             block += 1
   50:             data += chunk
   16:     data = _mk_bitmap(data)
   16:     data[0:0] = [block] + _bytes_to_codes(mapping)
   16:     out.append((BIGCHARSET, data))
   16:     out += tail
   16:     return out, hascased
       
